# =====================================================================
# .gitignore - MJ STRUCT WEB (PROTECCIÓN PARA GITHUB PAGES)
# =====================================================================

# 1. PROTECCIÓN CRÍTICA: Excluir toda la carpeta Simulador Complexivo/
# Evita exponer bancos JSON con respuestas, configuraciones de licencias e imágenes internas en GitHub público
/_PRIVADO_NO_PUBLICAR/
Simulador Complexivo/
/CSI a cualquier version/

# 2. Entornos virtuales pesados de Python (cientos de MB de faster-whisper / ctranslate2)
Transcriptor de Audio/.venv/
**/__pycache__/
*.pyc

# 3. Archivos temporales de compilación de MapaPro
MapaPro-MJ Struct/_work/
MapaPro-MJ Struct/*.bat

# 4. Compilación de Android Studio / Gradle en Cubicar de vigas
Cubicar de vigas/.gradle/
Cubicar de vigas/build/
Cubicar de vigas/app/build/
Cubicar de vigas/local.properties
Cubicar de vigas/.idea/

# 5. Accesos directos locales de Windows y archivos de sistema
*.lnk
.DS_Store
Thumbs.db
